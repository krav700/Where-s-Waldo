//   scores   Score[]
// }

model Character {
  id               String  @id @default(uuid()) @db.Uuid
  name             String
  color            String
  imgSrc           String
  guessed          Boolean @default(false)
  startXCoordinate Float
  endXCoordinate   Float
  startYCoordinate Float
  endYCoordinate   Float

  mapId String @db.Uuid
  map Map @relation(fields: [mapId], references: [id], onDelete: Cascade)
}

model Map {
  id         String     @id @default(uuid()) @db.Uuid
  title      String
  imgSrc     String
  characters Character[]
  scores     Score[]
}

model Score {
  id    String   @id @default(uuid()) @db.Uuid
  score String

  // userUsername String
  // user   User   @relation(fields: [userUsername], references: [username], onDelete: Cascade)
  username String

  mapId String @db.Uuid
  map   Map    @relation(fields: [mapId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}